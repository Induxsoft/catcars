#include "dkli.dkh"
#!
module ""
{
    @table_name="car_version"
    like=" and if(ifnull(@s,'')='',true,concat_ws('',v.codigo,v.descripcion,v.ano,m.codigo,m.descripcion,cm.codigo,cm.descripcion) like concat('%',@s,'%')  )"
    
    @list_query="select v.*,cm.codigo codmarca,cm.descripcion descmarca,m.codigo codmodelo,m.descripcion descmodelo
    from #<@table_name> v inner join car_modelo m on v.ref_car_modelo=m.sys_pk
    inner join car_marca cm on m.ref_car_marca=cm.sys_pk
    where ifnull(v.sys_deleted,0)=0  "+like
    
    @read_query="
        SELECT v.*, m.ref_car_marca
        FROM #<@table_name> v 
            INNER JOIN car_modelo m ON v.ref_car_modelo=m.sys_pk
        WHERE v.#<@keyfield> = @_entity_id;
    "
    
    prepareView::&db,&params,&rec
    {
        if isnull(rec){return}
         rec<"marcas*">:dbr.list(db,"select * from car_marca where ifnull(sys_deleted,0)=0",params)
    }
    blank::&db,&params
    {
       new entity{@"codigo":""}
       do prepareView(db,params,entity)
       return entity
    }
    read::&db,&params
    {
        if not(dbr.security.isauth(db,@CAT_AUT_VERSION_VEHICULO_READONLY)) { do rise_error(500,"No autorizado") }

        ref entity = entity.read(db,params)
        do prepareView(db,params,entity)
        return entity
    }

    function list(&db, &params)
    {
        if not(dbr.security.isauth(db,@CAT_AUT_ACCESS_VERSION_VEHICULO)) { do rise_error(500,"No autorizado") }

        return entity.list(db, params)
    }
    function create(&db, &params, &data)
    {
        if not(dbr.security.isauth(db,@CAT_AUT_CREATE_VERSION_VEHICULO)) { do rise_error(500,"No autorizado") }

        return entity.create(db, params)
    }
    function update(&db, &params, &data)
    {
        if not(dbr.security.isauth(db,@CAT_AUT_UPDATE_VERSION_VEHICULO)) { do rise_error(500,"No autorizado") }

        return entity.update(db, params)
    }
    function delete(&db, &params)
    {
        if not(dbr.security.isauth(db,@CAT_AUT_DELETE_VERSION_VEHICULO)) { do rise_error(500,"No autorizado") }

        return entity.delete(db, params)
    }

    point @read to read
    point @list to list
    point @blank to blank
    point @create to create
    point @update to update
    point @delete to delete
}