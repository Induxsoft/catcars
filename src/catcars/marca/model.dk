#include "dkli.dkh"
#!
module ""
{
    @table_name="car_marca"
    like=" and if(ifnull(@s,'')='',true,concat_ws('',codigo,descripcion,url) like concat('%',@s,'%')  )"
    @list_query="select * from #<@table_name> where ifnull(sys_deleted,0)=0 "+ like

    function check_autocode(&db,table,field,&data)
    {
        varvalue = dbr.vars.getd(db,"FXCA120","|0000")
        ref config = dbr.autocode.info(varvalue)
        new_code = dbr.autocode.new(db,table,field,config)

        data<"codigo">: new_code

        exception{do pop_exception()}
    }

    function list(&db, &params)
    {
        do dbr.apps.action.grant("CC10")
        return entity.list(db, params)
        exception{ do catch(db,params,@null) }
    }

    function read(&db, &params)
    {
        do dbr.apps.action.grant("CC10")
        return entity.read(db, params)
        exception{ do catch(db,params,@null) }
    }

    function blank(&db,&params)
    {
        do dbr.apps.action.grant("CC10")
        return record.create()
        exception{ do catch(db,params,@null) }
    }

    function create(&db, &params, &data)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("CC11")
        do dbr.begin(db)

        if @@(data,"codigo")=="" { do check_autocode(db,"car_marca","codigo",data) }
        ref entity = entity.create(db, params, data)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        return entity
        exception{ do catch(db,params,data) }
    }

    function update(&db, &params, &data)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("CC12")
        do dbr.begin(db)

        ref entity = entity.update(db, params, data)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        return entity
        exception{ do catch(db,params,data) }
    }

    function delete(&db, &params)
    {
        @use_transaction = @false

        do dbr.apps.action.pre("CC13")
        do dbr.begin(db)

        ref entity = entity.delete(db, params)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        return entity
        exception{ do catch(db,params,@null) }
    }

    catch::&db,&params,&data
    {
        do errordet(@false)
        code = last_error_code()
        error = last_error()

        if dbr.in_transaction(db) { do dbr.rollback(db) }
        if isset("@@_action_context") { do dbr.apps.action.log() }

        if @@(params,"$_operation")=="create" || @@(params,"$_operation")=="update"
        {
            if isnull(data) { ref data:record.create() }
            if contains(error,"Duplicate entry") { error = "Entrada duplicada, ya existe un registro con los mismos valores." }

            // ref FormData = record.copy(data,"*")
            // do record.clear(data)
            // data<"form*"> : FormData
            
            // do prepareView(db,params,data)
        }
        
        do rise_error(code,error)
    }

    point @list to list
    point @read to read
    point @blank to blank
    point @create to create
    point @update to update
    point @delete to delete
}