#include "dkli.dkh"
#!
module ""
{
    @table_name = "car_compatible"
    @list_query = "
    SELECT
        c.sys_pk,
        p.codigo AS cproducto,
        p.descripcion AS `producto`,
        p.unidad,
        pl.descripcion AS `linea`,
        IFNULL(pm.descripcion,'') AS `marca`,
        IFNULL(pd.descripcion,'') AS `departamento`,
        cmc.descripcion AS `car_marca`,
        cm.descripcion AS `car_modelo`,
        IFNULL(cv.descripcion,'') AS `car_version`,
        c.ano AS anio
    FROM #<@table_name> AS c
        INNER JOIN producto AS p ON c.ref_producto = p.sys_pk
            INNER JOIN linea AS pl ON p.ilinea = pl.sys_pk
            LEFT JOIN marca AS pm ON p.imarca = pm.sys_pk
            LEFT JOIN departamento AS pd ON p.idepartamento = pd.sys_pk
        INNER JOIN car_modelo AS cm ON c.ref_modelo = cm.sys_pk
            INNER JOIN car_marca AS cmc ON cm.ref_car_marca = cmc.sys_pk
        LEFT JOIN car_version AS cv ON c.ref_version = cv.sys_pk
    WHERE NOT IFNULL(c.sys_deleted,0)
    "
    @read_query = "
    SELECT
        sys_pk,
        sys_guid,
        sys_recver,
        ref_producto,
        ref_modelo,
        ref_version,
        ano
    FROM #<@table_name>
    WHERE #<@keyfield> = @_entity_id
    "

    car.buscarProducto::&db,&params
    {
        sql = "SELECT sys_pk, codigo, descripcion FROM producto WHERE #<condition>"
        
        if trim(@@(params,"$id")) != "" {
            condition = "(sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != "" {
            condition = "(codigo LIKE CONCAT('%',@search,'%') OR descripcion LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }

        return list.create()
    }

    car.buscarMarca::&db,&params
    {
        sql = "SELECT sys_pk, codigo, descripcion FROM car_marca WHERE #<condition> ORDER BY sys_pk ASC;"
        
        if trim(@@(params,"$id")) != "" {
            condition = "(sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != "" {
            condition = "(codigo LIKE CONCAT('%',@search,'%') OR descripcion LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }

        return list.create()
    }

    car.buscarModelo::&db,&params
    {
        sql = "
            SELECT m.sys_pk, m.codigo, m.descripcion, CONCAT(m2.descripcion,' - ', m.descripcion) descripcion2
            FROM car_modelo m
                INNER JOIN car_marca m2 ON m.ref_car_marca = m2.sys_pk
            WHERE #<condition> 
            ORDER BY sys_pk ASC;
        "
        
        if trim(@@(params,"$id")) != "" {
            condition = "(m.sys_pk = @id OR m.sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if @@(params,"#imarca") > 0 {
            condition = "m.ref_car_marca = @imarca"
            return dbr.list(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != "" {
            condition = "(m.codigo LIKE CONCAT('%',@search,'%') OR m.descripcion LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }

        return list.create()
    }

    car.buscarVersion::&db,&params
    {
        sql = "SELECT sys_pk, codigo, descripcion FROM car_version WHERE #<condition> ORDER BY sys_pk ASC;"
        
        if trim(@@(params,"$id")) != "" {
            condition = "(sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if @@(params,"#imodelo") > 0 {
            condition = "ref_car_modelo = @imodelo"
            return dbr.list(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != "" {
            condition = "(codigo LIKE CONCAT('%',@search,'%') OR descripcion LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }

        return list.create()
    }

    car.obtenerProducto::&db,id
    {
        new params { @"id":id }
        return car.buscarProducto(db,params)
    }

    car.obtenerModelo::&db,id
    {
        new params { @"id":id }
        return car.buscarModelo(db,params)
    }

    prepareView::&db,&params,&data
    {
        isNew = (@@(params,"$_entity_id") == "_new")

        switch @@(@http_context,"$request/get/_view")
        {
            case ""
            {
                sql_versions = "SELECT sys_pk, codigo, descripcion, CONCAT(descripcion,' - ', ano) descripcion2, ano, ref_car_modelo FROM car_version WHERE NOT IFNULL(sys_deleted,0)"

                if not(isNew) || field.exist(data,"form")
                {
                    ref_producto = @@(data,"#form/ref_producto")
                    ref_modelo = @@(data,"#form/ref_modelo")

                    if ref_producto <= 0 { ref_producto = @@(data,"#entity/ref_producto") }
                    if ref_modelo <= 0 { ref_modelo = @@(data,"#entity/ref_modelo") }

                    data<"producto*"> : car.obtenerProducto(db,ref_producto)
                    data<"modelo*"> : car.obtenerModelo(db,ref_modelo)
                }

                data<"list_version*"> : dbr.list(db,sql_versions,@null)
                break
            }
        }
    }

    car.list::&db,&params
    {
        new data
        {
            @"list_linea*": dbr.list(db,"select sys_pk, descripcion from linea",@null)
            @"list_marca*": dbr.list(db,"select sys_pk, descripcion from marca",@null)
            @"list_departamento*": dbr.list(db,"select sys_pk, descripcion from departamento",@null)
            @"list_car_marca*": dbr.list(db,"select sys_pk, descripcion from car_marca",@null)
            // @"list_car_modelo*": dbr.list(db,"select sys_pk, descripcion from car_modelo",@null)
            // @"list_car_version*": dbr.list(db,"select sys_pk, descripcion from car_version",@null)
        }

        if @@(params,"#ilinea") > 0 { @list_query = @list_query + " AND pl.sys_pk = @ilinea" }
        if @@(params,"#imarca") > 0 { @list_query = @list_query + " AND pm.sys_pk = @imarca" }
        if @@(params,"#idepto") > 0 { @list_query = @list_query + " AND pd.sys_pk = @idepto" }
        if @@(params,"#car_marca") > 0 { @list_query = @list_query + " AND cmc.sys_pk = @car_marca" }
        if @@(params,"#car_modelo") > 0 { @list_query = @list_query + " AND cm.sys_pk = @car_modelo" }
        if @@(params,"#car_version") > 0 { @list_query = @list_query + " AND cv.sys_pk = @car_version" }

        if trim(@@(params,"$text")) != "" 
        {
            @list_query = @list_query + " AND (
                p.descripcion LIKE CONCAT('%',@text,'%')
                OR cmc.descripcion LIKE CONCAT('%',@text,'%')
                OR cm.descripcion LIKE CONCAT('%',@text,'%')
                OR cv.descripcion LIKE CONCAT('%',@text,'%')
            )"
        }

        data<"list*"> : entity.list(db,params)
        
        // do rise_error(0,@list_query)
        return data
    }

    car.read::&db,&params
    {
        new data
        {
            @"entity*": entity.read(db,params)
        }
        do prepareView(db,params,data)

        return data
    }

    car.blank::&db,&params
    {
        new data {}
        do prepareView(db,params,data)
        return data
    }

    car.vData::&db,&params,&data
    {
        new car_compatible
        {
            @"sys_recver": @@(data,"#sys_recver")
            @"ref_producto": @@(data,"#ref_producto")
            @"ref_modelo": @@(data,"#ref_modelo")
            @"ref_version": @@(data,"#ref_version")
            @"ano": @@(data,"#ano")
        }

        if @@(car_compatible,"#ref_producto") <= 0 { do rise_error(500,"Es necesario elegir el <strong>Producto</strong>.") }
        if @@(car_compatible,"#ref_modelo") <= 0 { do rise_error(500,"Es necesario elegir el <strong>Modelo</strong>.") }
        if @@(car_compatible,"#ref_version") <= 0 { car_compatible<"ref_version*"> : @null }
        if @@(car_compatible,"#ano") <= 0 { do rise_error(500,"El campo <strong>Año</strong> es requerido.") }

        return car_compatible
    }

    car.create::&db,&params,&data
    {
        do errordet(@false)
        ref car_compatible = car.vData(db,params,data)
        do entity.create(db,params,car_compatible)

        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    car.update::&db,&params,&data
    {
        do errordet(@false)
        ref car_compatible = car.vData(db,params,data)
        do entity.update(db,params,car_compatible)

        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do prepareView(db,params,data)
            do rise_error(code,error)
        }
    }
}