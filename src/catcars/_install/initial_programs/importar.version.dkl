#include "dkli.dkh"
#!
program
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "batch.v12.dkl"

    ref db = @@(@batch_context,"&database")
    ref @batchDB = db

    token = @@(@batch_context,"$job/token")
    steps = @@(@batch_context,"#job/steps")
    data_file = @@(@batch_context,"$params/archivo")

    if (right(data_file,4) != ".csv") {
        do file.delete(data_file)
        do batch.saveLog(token,"Extensión incorrecta del archivo, se esperaba un .csv")
        return
    }

    ref lib_csv = _import_library("devkron.serialize.csv.dll")
    do _map_function(lib_csv,"devkron.serialize.csv.csvHelper","CsvRead","CsvRead","System.String,System.String","*")

    query1 = "SELECT codigo FROM car_modelo WHERE sys_pk = @ref_car_modelo"
    query2 = "SELECT codigo FROM car_version WHERE codigo = @codigo"
    query3 = "INSERT INTO car_version (codigo, descripcion, ref_car_modelo, ano, sys_guid, sys_timestamp) VALUES (@codigo, @descripcion, @ref_car_modelo, @ano, @sys_guid, @sys_timestamp)"
    query4 = "UPDATE car_version SET descripcion = @descripcion, ref_car_modelo = @ref_car_modelo, ano = @ano WHERE codigo = @codigo"

    if file.exists(data_file) {
        ref data = CsvRead(data_file,"")
        do file.delete(data_file)

        list_size = @count(data)
        contador = 0
        progreso = 0
        div = (list_size/steps)
        
        for i=0; i<list_size {
            ref itm = record.caseinsensitive(@item(data,i))

            codigo = length(@@(itm,"codigo"))
            descripcion = length(@@(itm,"descripcion"))
            ref_car_modelo = length(@@(itm,"ref_car_modelo"))
            ano = length(@@(itm,"ano"))

            if ((codigo < 1 || codigo > 15) || (descripcion < 1 || descripcion > 50) || (ref_car_modelo < 1 || ref_car_modelo > 11) || (ano < 1 || ano > 11)) {
                log = "Error al insertar el registro con codigo = '" + @@(itm,"codigo") + "', descripcion = '" + @@(itm,"descripcion") + "' y año = '" + @@(itm,"ano") + "'"
                do batch.saveLog(token,log)
            } else {
                valid_ref_car_modelo = dbr.str(db,query1,itm)

                if (valid_ref_car_modelo != "") {
                    duplicated =  dbr.str(db,query2,itm)

                    if (duplicated != "") {
                        do dbr.execute(db,query4,itm)
                    } else {
                        itm<"sys_guid">: uuid()
                        itm<"sys_timestamp*">: now()

                        do dbr.execute(db,query3,itm)
                    }
                } else {
                    do batch.saveLog(token,"Error al insertar el registro con ref_car_modelo = '" + @@(itm,"ref_car_modelo") + "'")
                }
            }

            contador = contador + 1

            if (contador >= div) {
                contador = contador - div
                progreso = progreso + steps
                do batch.saveLog(token,"En proceso... " + str(progreso) + "%")
            }
        }

        exception 
        {
            do file.delete(data_file)
            do batch.saveLog(token,last_error())
        }
    }
}