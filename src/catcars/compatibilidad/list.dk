#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/icons.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)
    ref db:@("&database")

    //#region DEFINICIÓN DE FILTROS SELECTS
    new fil_linea
    {
        @"datatable*": ifnull(@("&./list_linea"),list.create())
        @"id": "fil_linea"
        member "attributes"
        {
            @"name": "ilinea"
            @"class": "induxsoft-form-select"
            @"title": "Filtrar por lineas"
            @"disabled": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"first_value": "0"
        @"first_text": "(Todos)"
        @"selected": @("#parameters/ilinea")
    }
    
    new fil_marca
    {
        @"datatable*": ifnull(@("&./list_marca"),list.create())
        @"id": "fil_marca"
        member "attributes"
        {
            @"name": "imarca"
            @"class": "induxsoft-form-select"
            @"title": "Filtrar por marcas"
            @"disabled": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"first_value": "0"
        @"first_text": "(Todos)"
        @"selected": @("#parameters/imarca")
    }

    new fil_departamento
    {
        @"datatable*": ifnull(@("&./list_departamento"),list.create())
        @"id": "fil_departamento"
        member "attributes"
        {
            @"name": "idepto"
            @"class": "induxsoft-form-select"
            @"title": "Filtrar por departamentos"
            @"disabled": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"first_value": "0"
        @"first_text": "(Todos)"
        @"selected": @("#parameters/idepto")
    }

    new fil_car_marca
    {
        @"datatable*": ifnull(@("&./list_car_marca"),list.create())
        @"id": "fil_car_marca"
        member "attributes"
        {
            @"name": "car_marca"
            @"class": "induxsoft-form-select"
            @"title": "Filtrar por modelos"
            @"disabled": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"first_value": "0"
        @"first_text": "(Todos)"
        @"selected": @("#parameters/car_marca")
    }

    new fil_car_modelo
    {
        @"datatable*": list.create()
        @"id": "fil_car_modelo"
        member "attributes"
        {
            @"name": "car_modelo"
            @"class": "induxsoft-form-select"
            @"title": "Filtrar por modelos"
            @"disabled": ""
        }
        @"first_value": "0"
        @"first_text": "(Todos)"
        @"selected": @("#parameters/car_modelo")
    }

    new fil_car_version
    {
        @"datatable*": list.create()
        @"id": "fil_car_version"
        member "attributes"
        {
            @"name": "car_version"
            @"class": "induxsoft-form-select"
            @"title": "Filtrar por versiones"
            @"disabled": ""
        }
        @"first_value": "0"
        @"first_text": "(Todos)"
        @"selected": @("#parameters/car_version")
    }
    //#endregion

    form_bar_buttons::
    {
        _btn_cls = "btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"

        if AppExist(@("&database"),"batch")
        {
            ref db:@("&database")
            query = "SELECT sys_pk FROM jobsgroup WHERE name = 'CATCARS';"
            jg = dbr.num(db,query,@null)

            #$ a(href="#<@BATCH_TASKMAN>#<jg>/importar.compatibilidad?exit_url_encode=#<url_encode(@CAR_COMPATIBILIDAD)>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Importar compatibilidades"){$"#<@ICON_FILE_CSV>"}
        }

        #$
        a(href="./_new/" class="#<_btn_cls>"){$"Agregar"}
        a(href="#<@CATCARS_MARCA>" class="#<_btn_cls>"){$"Marcas"}
        a(href="#<@CATCARS_MODELO>" class="#<_btn_cls>"){$"Modelos"}
        a(href="#<@CATCARS_VERSION>" class="#<_btn_cls>"){$"Versiones"}
        #!
    }
    point print_buttons to form_bar_buttons

    new v12_form_bar_cfg
    {
        @"title": "Compatibilidad de partes"
        @"buttons*": print_buttons
        @"urlexit": "/"
    }

    _actions_btn_cls = "cursor:pointer; text-decoration:none; padding: 0px 8px; background-color:#F5F5F5; color:#000;"

    new table_definition
    {
        @"datatable*": ifnull(@("&./list"),list.create())
        @"value_field":"sys_pk"
        member @"columns"
        {
            member @"cproducto" { @"caption": "Código" }
            member @"producto" { @"caption": "Producto" }
            member @"unidad" { @"caption": "Unidad" }
            member @"linea" { @"caption": "Linea" }
            member @"marca" { @"caption": "Marca" }
            member @"car_marca" { @"caption": "Marca vehículo" }
            member @"car_modelo" { @"caption": "Modelo vehículo" }
            member @"car_version" { @"caption": "Versión vehículo" }
            
            member @"_actions"
            {
                @"caption": "Acciones"
                @"no-print": @true
                @"template": ftext('
                    <div class="no-print" style="display:flex;justify-content:center;align-items:center;gap:6px;">
                        <a href="./${DataRow.sys_pk}/" style="#<_actions_btn_cls>">Editar</a>
                        <a href="#" onclick="InduxsoftCrudlModel.Delete(${DataRow.sys_pk})" style="#<_actions_btn_cls>">Eliminar</a>
                    </div>
                ')
            }
        }
    }

    #$ div(class="container-fluid p-0" id="")
    {
        #! do uie.printV12FormBar(v12_form_bar_cfg)
        #$ div(class="container-section mt-1 p-2 pt-0" id="work_area")
        {
            form(action="./" method="GET" id="form_filter" class="no-print mb-1")
            {
                div(class="py-1 w-100 d-flex gap-2 flex-wrap align-items-center")
                {
                    div(class="d-flex gap-2")
                    {
                        div{ #! do uie.dbSelect(fil_linea) } #$
                        div{ #! do uie.dbSelect(fil_marca) } #$
                        div{ #! do uie.dbSelect(fil_departamento) } #$
                        div{ #! do uie.dbSelect(fil_car_marca) } #$
                        div{ #! do uie.dbSelect(fil_car_modelo) } #$
                        div{ #! do uie.dbSelect(fil_car_version) } #$

                        button(class="btn btn-link border-primary rounded-0" type="button" id="btn_aplicar_filtros"){$"Modificar"}
                        button(class="btn btn-link border-primary rounded-0 d-none" type="reset" id="btn_reset_filters"){$"Cancelar"}
                    }
                }
                div(class="")
                {
                    #$"filter-text"(
                        "id"="micontrol10"
                        "text-field"="text"
                        "placeholder"="Producto, [marca, modelo, version] del vehículo"
                        "form"="#form_filter"
                        "value"="#<@('$parameters/text')>"
                        "auto-submit"="true"
                        "class"="w-100"
                    ){$""}
                }
            }

            #! do uie.dbeditable(table_definition,"tbl_car_compatible")
        } #$

        div
        {
            script(src="#<@JS_COMPATIBILIDAD>"){$""}
            script(type="text/javascript")
            {$'
                document.addEventListener("DOMContentLoaded", () => {
                    compatibilidad.list._GET = #<to.json(@("&parameters"))> ?? {};
                    compatibilidad.list.url_buscar_car_modelo = "#<@URL_SEARCH_MODELO>";
                    compatibilidad.list.url_buscar_car_version = "#<@URL_SEARCH_VERSION>";
                    compatibilidad.list.init();
                });
            '}
        }
    }

    #! do @context.end()
}