    @URL_SEARCH_MODELO = "/!/catcars/compatibilidad/?_view=buscar-modelo&search=@search"
    @URL_SEARCH_VERSION = "/!/catcars/compatibilidad/?_view=buscar-version&search=@search"

    // _STATIC
