#include "dkli.dkh"
#!
program
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "batch.v12.dkl"

    ref db = @@(@batch_context,"&database")
    ref @batchDB = db

    token = @@(@batch_context,"$job/token")
    steps = @@(@batch_context,"#job/steps")
    data_file = @@(@batch_context,"$params/archivo")

    if (right(data_file,4) != ".csv") {
        do file.delete(data_file)
        do batch.saveLog(token,"Extensión incorrecta del archivo, se esperaba un .csv")
        return
    }

    ref lib_csv = _import_library("devkron.serialize.csv.dll")
    do _map_function(lib_csv,"devkron.serialize.csv.csvHelper","CsvRead","CsvRead","System.String,System.String","*")

    query1 = "SELECT sys_pk FROM car_marca WHERE codigo = @ref_car_marca"
    query2 = "SELECT codigo FROM car_modelo WHERE codigo = @codigo"
    query3 = "INSERT INTO car_modelo (codigo, descripcion, ref_car_marca, sys_guid, sys_timestamp) VALUES (@codigo, @descripcion, @ref_car_marca, @sys_guid, @sys_timestamp)"
    query4 = "UPDATE car_modelo SET descripcion = @descripcion, ref_car_marca = @ref_car_marca WHERE codigo = @codigo"

    if file.exists(data_file) {
        ref data = CsvRead(data_file,"")
        do file.delete(data_file)

        list_size = @count(data)
        contador = 0
        progreso = 0
        div = (list_size/steps)
        
        for i=0; i<list_size {
            ref itm = record.caseinsensitive(@item(data,i))

            codigo = length(@@(itm,"codigo"))
            descripcion = length(@@(itm,"descripcion"))
            ref_car_marca = length(@@(itm,"ref_car_marca"))

            if (codigo < 1 || codigo > 15) {
                do batch.saveLog(token,"No se pudo insertar/actualizar el registro. El código (" + @@(itm,"codigo") + ") debe ser de mínimo 1 caracter y máximo 15 caracteres.")
            } else if (descripcion < 1 || descripcion > 50) {
                do batch.saveLog(token,"No se pudo insertar/actualizar el registro. La descripción (" + @@(itm,"descripcion") + ") debe ser de mínimo 1 caracter y máximo 50 caracteres.")
            } else if (ref_car_marca < 1 || ref_car_marca > 11) {
                do batch.saveLog(token,"No se pudo insertar/actualizar el registro. La ref_car_marca (" + @@(itm,"ref_car_marca") + ") debe ser de mínimo 1 caracter y máximo 11 caracteres.")
            } else {
                valid_ref_car_marca = dbr.str(db,query1,itm)

                if (valid_ref_car_marca != "") {
                    duplicated =  dbr.str(db,query2,itm)

                    itm<"ref_car_marca">: valid_ref_car_marca

                    if (duplicated != "") {
                        do dbr.execute(db,query4,itm)
                    } else {
                        itm<"sys_guid">: uuid()
                        itm<"sys_timestamp*">: now()

                        do dbr.execute(db,query3,itm)
                    }
                } else {
                    do batch.saveLog(token,"No se pudo insertar/actualizar el registro. No existe un ref_car_marca (" + @@(itm,"ref_car_marca") + ") con ese valor.")
                }
            }

            contador = contador + 1

            if (contador >= div) {
                contador = contador - div
                progreso = progreso + steps
                do batch.saveLog(token,"En proceso... " + str(progreso) + "%")
            }
        }

        exception 
        {
            do file.delete(data_file)
            do batch.saveLog(token,last_error())
        }
    }
}