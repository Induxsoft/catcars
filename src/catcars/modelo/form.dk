#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../_lib/config.dk"
    #include "../_lib/icons.dk"

    do @context.begin(@crud_context)

    ref data = @("&./")
    entity_id = @("$parameters/_entity_id")
    error = @("$error/message")
    isNew = (entity_id == "_new")
    action = replace(@CATCARS_ADD_EDIT_MODELO, "@id", entity_id)
    
    #$
    div(class="container")
    {
        form(method="POST" action="#<action>" id="form")
        {
            div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
            {
                div(class="col-4 d-flex align-items-center p-0")
                {
                    h5(class="tex-no-break m-0"){$"#<ifstr(isNew,'Agregar','Editar')> Modelo"}
                }

                div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
                {
                    a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar") {
                        $"#<@ICON_ARROW_CLOCKWISE>"
                    }

                    button(type="submit" class="btn btn-sm border-secondary induxsoft-corners btn-main-action") {
                        $"#<@ICON_SAVE>"
                    }

                    a(class="btn btn-sm border-secondary induxsoft-corners btn-main-action" href="#<@CATCARS_MARCA>") {
                        $"#<@ICON_X_LG>"
                    }
                }
            }
            
            div(id="work_area" class="container-section")
            {
                div(class="#<ifstr(@('error/message')!='','alert alert-danger','')>"){$"#<@('error/message')>"}

                input(type="hidden" name="sys_pk" value="#<@@(data, '#sys_pk')>")
                input(type="hidden" name="sys_recver" value="#<@@(data, '#sys_recver')>")

                div(class="row mb-2 mt-4")
                {
                    div(class="col-sm-4")
                    {
                        small(class="fw-bold"){$"Código:"}
                        input(type="text" class="induxsoft-form-control mb-2" name="codigo" value="#<@@(data, '$codigo')>" maxlength="15" placeholder="<A>")
                    }

                    div(class="col-sm-8")
                    {
                        small(class="fw-bold"){$"Descripción:"}
                        input(type="text" class="induxsoft-form-control mb-2" name="descripcion" value="#<@@(data, '$descripcion')>" required="true" maxlength="50")
                    }
                }
                
                small{$"Marca:"}
                select(class="induxsoft-form-select" name="ref_car_marca" required="true")
                {$""
                    #! for i = 0; i < @count(@("&./marcas"))
                    {
                        ref marca=@item(@("&./marcas"),i)
                        #$ option(value="#<@@(marca,'sys_pk')>" "#<ifstr(@('$./ref_car_marca')==@@(marca,'$sys_pk'),'selected','')>"="true"){"#<@@(marca,'$codigo')+' '+@@(marca,'$descripcion')>"}
                    }
                }
            }
        }
    }
}