#include "dkli.dkh"
#!
module "list"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.apps.dkl"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/icons.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)
    ref marcas = @("&./")

    new nav_config
    {
        @"title": "Marcas de vehículos"
        @"buttons*": @null
        @"urlexit": "/"
        @"main": "CC14,CC11,CC12,CC13"
        @"actions*": dbr.apps.itemactions(@('&database'),"DET02C","action","",0)
        @"reports*": dbr.apps.itemactions(@('&database'),"DET02C","report","",0)
        @"jscurrentcontext": "getCurrentContext"
    }

    new table_definition
    {
        @"datatable*": marcas
        new member @"columns"
        {
            new member @"codigo" { @"caption": "Código" }
            new member @"descripcion" { @"caption": "Descripción" }
            new member @"url" { @"caption": "URL" }
        }
    }
    
    #$
    div(class="container p-0")
    {
        #! do uie.printV12FormBar(nav_config)

        #$
        div(id="work_area" class="container-section pt-2")
        {
            form(action="./" method="GET" id="form_filter" class="no-print my-1 d-flex py-1")
            {
                "filter-text"(
                    "id"="fil_text"
                    "text-field"="s"
                    "placeholder"="Buscar ..."
                    "form"="#form_filter"
                    "value"="#<@('$parameters/s')>"
                    "auto-submit"="true"
                    "class"="w-100"
                ){$""}
            }
            #! do uie.dbeditable(table_definition, "tbl_marcas")
        }

        #$
		script(type="text/javascript")
		{$'
			function getCurrentContext()
			{
				const table = document.getElementById("tbl_marcas");
				const id = (table?.DataArray[table.CurrentRowIndex()]?.sys_pk ?? "");
    			return { item_id:id, context: {} }
			}
		'}
    }
}