#include "dkli.dkh"
#!
module "list"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "../_lib/config.dk"
    #include "../_lib/icons.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)
    ref db:@("&database")
    ref marcas = @("&./")

    query = "SELECT sys_pk FROM jobsgroup WHERE name = 'CATCARS';"
    jg = dbr.num(db,query,@null)
    
    #$
    div(class="container p-0")
    {
        div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
        {
            div(class="col-4 d-flex align-items-center p-0")
            {
                h5(class="tex-no-break m-0"){$"Marcas de vehículos"}
            }

            div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Refrescar") {
                    $"#<@ICON_ARROW_CLOCKWISE>"
                }
                
                #! if AppExist(db,"batch") {
                    #$ a(href="#<@BATCH_TASKMAN>#<jg>/importar.marca?exit_url_encode=#<url_encode(@CATCARS_MARCA)>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Importar marcas") {
                        $"#<@ICON_FILE_CSV>"
                    }
                }
                
                #$ a(href="#<replace(@CATCARS_ADD_EDIT_MARCA, '@id', '_new')>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print") {
                    $"Agregar"
                }

                button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Imprimir" onclick="window.print()") {
                    $"#<@ICON_PRINTER>"
                }

                a(href="/" target="_top" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Salir") {
                    $"#<@ICON_X_LG>"
                }
            }
        }

        div(id="work_area" class="container-section pt-2")
        {
            form(action="./" method="GET" id="form_search" class="d-flex mb-2 no-print")
            {
                input(class="induxsoft-form-control flex-grow-1" type="search" name="s" placeholder="Buscar" id="input_search" value='#<@@(@crud_context,"$parameters/s")>')
                button(class="btn btn-sm btn-primary induxsoft-corners d-flex gap-2 align-items-center") {
                    $"Buscar"
                    $"#<@ICON_SEARCH>"
                }
            }

            div
            {
                #! lenght = list.count(marcas)
                if lenght <= 0
                {
                    message = ""
                    if @@(@crud_context,"$parameters/s") == "" { message = "Sin registros." }
                    else  { message = "Sin resultados." }

                    #$ div(class="text-center")
                    {
                        h6(style="background-color: #F5F5F5; padding: 10rem 0;"){"#<message>"}
                    }
                }
                #! else 
                {
                    #$ div(style="overflow-y:auto;max-height: 75vh;" class="mb-2" id="list_table_container")
                    {
                        table(class="table")
                        {
                            thead
                            {
                                tr
                                {
                                    th(class="h6"){"Código"}
                                    th(class="h6"){$"Descripción"}
                                    th(class="h6"){$"URL"}
                                    th(class="h6"){$""}
                                }
                            }
                            tbody
                            {
                                $""
                                #! for i = 0; i < list.count(marcas)
                                {
                                    ref marca = list.obj(marcas, i)

                                    #$ tr
                                    {
                                        td{"#<@@(marca,'$codigo')>"}
                                        td{$"#<@@(marca,'$descripcion')>"}
                                        td{$"#<@@(marca,'$url')>"}
                                        td(class="no-print")
                                        {
                                            div(class="d-flex gap-2 justify-content-center")
                                            {
                                                a(href="#<replace(@CATCARS_ADD_EDIT_MARCA, '@id', @@(marca,'sys_pk'))>" class="btn btn-sm btn-light"){$"Editar"}
                                                button(class="btn btn-sm btn-light" onclick="InduxsoftCrudlModel.Delete(#<@@(marca,'sys_pk')>)"){$"Eliminar"}
                                            }
                                        }
                                    }
                                } 
                            }
                        }
                    }
                }
            }
        }
    }
}