	@CAT_AUT_CREATE_MARCA_VEHICULO = "CVM-00-00-002"
	@CAT_AUT_UPDATE_MARCA_VEHICULO = "CVM-00-00-003"
	@CAT_AUT_DELETE_MARCA_VEHICULO = "CVM-00-00-004"

    @CAT_AUT_ACCESS_MODELO_VEHICULO = "CDM-00-00-000"
	@CAT_AUT_MODELO_VEHICULO_READONLY = "CDM-00-00-001"
	@CAT_AUT_CREATE_MODELO_VEHICULO = "CDM-00-00-002"
	@CAT_AUT_UPDATE_MODELO_VEHICULO = "CDM-00-00-003"
