	@CAT_AUT_CREATE_VERSION_VEHICULO = "CVV-00-00-002"
	@CAT_AUT_UPDATE_VERSION_VEHICULO = "CVV-00-00-003"
	@CAT_AUT_DELETE_VERSION_VEHICULO = "CVV-00-00-004"
